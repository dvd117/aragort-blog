---
import Base from '../layouts/Base.astro';
import { card } from '../lib/card';

const name = `${card.given} ${card.family}`;
// The role names Ateneo Abierto; that name becomes the link.
const [roleHead, roleTail] = card.role.split(card.ateneo.name);
---
<!-- The virtual business card a QR code points to at events. In English for international
     rooms, so the card is marked lang="en" inside the Spanish site. Not indexed: the page a
     search for the name should land on is "Sobre mí". -->
<Base title="Card" description={`${name}: ${card.role}.`} noindex>
  <section class="wrap card" lang="en" aria-labelledby="card-name">
    <h1 id="card-name">{name}</h1>
    <p class="role">{roleHead}<a href={card.ateneo.href} rel="noopener noreferrer">{card.ateneo.name}</a>{roleTail}</p>
    <dl class="contact">
      <div><dt>Email</dt><dd><a href={`mailto:${card.email}`}>{card.email}</a></dd></div>
      <div><dt>Signal</dt><dd><a href={card.signal.href} rel="noopener noreferrer">{card.signal.name}</a></dd></div>
      <div><dt>LinkedIn</dt><dd><a href={card.linkedin.href} rel="me noopener noreferrer">{card.linkedin.name}</a></dd></div>
      <div><dt>Web</dt><dd><a href="/">{card.web.name}</a></dd></div>
    </dl>
    <a class="save" href="/david-aragort.vcf" download="david-aragort.vcf">Save contact</a>
  </section>
</Base>

<style>
  .card { max-width: 34rem; padding-top: 2.5rem; padding-bottom: 3.5rem; }
  h1 { margin: 0; font-family: var(--display); font-weight: var(--display-weight); font-size: clamp(2.6rem, 11vw, 4.25rem); line-height: var(--display-leading); letter-spacing: var(--display-tracking); }
  .role { margin: 1rem 0 2rem; font: 400 1.125rem/1.45 var(--ui); color: var(--fg-2); }
  /* The same rows as the contacts in "Sobre mí": one list, one hue, 44px targets. */
  .contact { margin: 0; display: grid; gap: .1rem; font: 400 1rem/1.3 var(--ui); }
  .contact div { display: grid; grid-template-columns: 5.5rem 1fr; align-items: center; min-height: 44px; border-bottom: 1px solid var(--rule); }
  .contact dt { color: var(--fg-2); font-size: .875rem; }
  .contact dd { margin: 0; overflow-wrap: anywhere; }
  .contact a, .role a { font-weight: 500; color: var(--hue); text-decoration: underline 1px color-mix(in srgb, var(--hue) 45%, transparent); text-underline-offset: .2em; }
  .contact a:hover, .role a:hover { text-decoration-color: var(--hue); text-decoration-thickness: 2px; }
  /* The one action: a solid block in the text colour, full width on a phone. */
  .save { display: flex; align-items: center; justify-content: center; min-height: 52px; margin-top: 2rem; border-radius: 6px; background: var(--fg); color: var(--bg); font: 600 1.0625rem/1 var(--ui); text-decoration: none; transition: opacity var(--dur-ui) var(--ease); }
  .save:hover { opacity: .88; }
  @media (min-width: 600px) { .save { display: inline-flex; padding: 0 2rem; } }
</style>
