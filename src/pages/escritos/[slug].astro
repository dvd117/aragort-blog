---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Net from '../../components/Net.astro';
import { getPosts, type Post } from '../../lib/collection';
import { formatDateEs } from '../../lib/posts';
import '../../styles/post.css';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props { post: Post; }
const { post } = Astro.props;
const { Content } = await render(post.entry);
const words = new Intl.NumberFormat('es').format(post.words);
---
<Base title={post.title} description={post.description} current="escritos" type="article">
  <div class="progress" aria-hidden="true"></div>
  <article class="wrap post">
    <header class="post-head">
      <p class="meta">
        <time datetime={post.date}>{formatDateEs(post.date)}</time> · {post.minutes} min de lectura · {words} palabras
        {post.draft && <span> · borrador</span>}
      </p>
      <h1>{post.title}</h1>
    </header>
    <div class="post-grid">
      <div class="rail" aria-hidden="true"><Net name="rail" progress /></div>
      <div class="prose">
        <Content />
      </div>
      <p class="sig"><Net name="mark" /><span>David Aragort</span></p>
    </div>
  </article>
</Base>

<script>
  /* Reading progress. Desktop: the rail's nodes light in reading order.
     Phone: a 3px hairline at the top. Under reduced motion the rail stays fully
     drawn and static; the hairline still reports position (state, not animation). */
  const body = document.querySelector<HTMLElement>('.post .prose');
  const bar = document.querySelector<HTMLElement>('.progress');
  const rail = document.querySelector<SVGSVGElement>('.rail .net[data-progress]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (body && bar) {
    const nodes = rail ? [...rail.querySelectorAll<SVGCircleElement>('circle')] : [];
    const wires = rail ? [...rail.querySelectorAll<SVGLineElement>('line')] : [];
    if (rail && !still) rail.classList.add('live');
    let queued = false;
    const update = () => {
      queued = false;
      const r = body.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.65 - r.top) / r.height));
      bar.style.transform = `scaleX(${p.toFixed(4)})`;
      if (!rail || still) return;
      const k = Math.round(p * nodes.length);
      nodes.forEach((c) => c.classList.toggle('on', Number(c.dataset.o) < k));
      wires.forEach((l) => l.classList.toggle('on', Number(l.dataset.a) < k && Number(l.dataset.b) < k));
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
