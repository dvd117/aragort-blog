---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Net from '../../components/Net.astro';
import { getPosts, type Post } from '../../lib/collection';
import { formatDateEs } from '../../lib/posts';
import { postVersion, versionLine } from '../../lib/versions';
import { servedMarkdown } from '../../lib/raw';
import '../../styles/post.css';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  // Neighbours for the end card: the newer post if there is one, else the older.
  return posts.map((post, i) => {
    const newer = posts[i - 1];
    const older = posts[i + 1];
    const next = newer ? { label: 'Siguiente', slug: newer.slug, title: newer.title } : older ? { label: 'Anterior', slug: older.slug, title: older.title } : null;
    return { params: { slug: post.slug }, props: { post, next } };
  });
}) satisfies GetStaticPaths;

interface Props { post: Post; next: { label: string; slug: string; title: string } | null; }
const { post, next } = Astro.props;
const { Content, headings } = await render(post.entry);
// ## headings are chapters; the index appears from three on.
const chapters = headings.filter((h) => h.depth === 2);
const version = versionLine(postVersion(post.file, post.date));
const source = await servedMarkdown(post.file, post.date.slice(0, 4));
const filename = `${post.id}.md`;
---
<Base title={post.title} description={post.description} current="escritos" type="article" ogImage={`/og/${post.slug}.png`} hue={post.hue} minutes={post.minutes} postTitle={post.title}>
  <article class="wrap post" data-slug={post.slug} data-minutes={post.minutes} data-has-rail-toc={chapters.length >= 3 ? '' : undefined}>
    <header class="post-head">
      <a class="back" href="/">← Escritos</a>
      {version && <p class="ver">{version}</p>}
      <p class="meta">
        <span class="hue-dot" aria-hidden="true" style={`view-transition-name: dot-${post.slug}`}></span>
        <time datetime={post.date}>{formatDateEs(post.date)}</time> · {post.minutes} min de lectura
        {post.draft && <span> · borrador</span>}
      </p>
      <h1 style={`view-transition-name: t-${post.slug}; view-transition-class: title`}>{post.title}</h1>
      {post.resumen && (
        <aside class="encorto" aria-labelledby="encorto-title">
          <h2 id="encorto-title">En corto</h2>
          <ul>{post.resumen.map((r) => <li>{r}</li>)}</ul>
        </aside>
      )}
      {chapters.length >= 3 && (
        <details class="toc" data-chapters={chapters.length}>
          <summary>En este texto</summary>
          <ol>{chapters.map((c) => <li><a href={`#${c.slug}`}>{c.text}</a></li>)}</ol>
        </details>
      )}
      <div class="view" role="group" aria-label="Cómo ver el artículo">
        <button type="button" data-view="read" aria-pressed="true">Formato</button>
        <button type="button" data-view="md" aria-pressed="false">Markdown</button>
      </div>
    </header>
    <div class="post-grid">
      <div class="rail">
        <div class="rail-net" aria-hidden="true"><Net name="rail" progress /></div>
        {chapters.length >= 3 && (
          <nav class="rail-toc" aria-label="Capítulos">
            <ol>{chapters.map((c, i) => <li><a href={`#${c.slug}`} data-chapter={i}><span class="num">{String(i + 1).padStart(2, '0')}</span>{c.text}</a></li>)}</ol>
          </nav>
        )}
      </div>
      <div class="prose" data-pane="read">
        <Content />
      </div>
      <div class="source" data-pane="md" hidden>
        <p class="file"><a href={`/escritos/${post.slug}.md`}>{filename}</a><button type="button" class="copy" data-copy><svg class="i-copy" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 3.5v-.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" /></svg><svg class="i-done" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg><span aria-live="polite">Copiar</span></button></p>
        <pre>{source}</pre>
      </div>
      <p class="sig"><a href="/sobre-mi/"><Net name="mark" /><span>David Aragort</span></a></p>
      <aside class="done-card" data-done aria-label="Fin del texto">
        {next && (
          <p class="dc-next"><span class="dc-label">{next.label}</span> <a href={`/escritos/${next.slug}/`}>{next.title}</a></p>
        )}
        <p class="dc-mail"><a href="mailto:hola@aragort.com">Escríbeme</a> <span>hola@aragort.com</span></p>
        <p class="dc-all"><a href="/">Todos los escritos</a></p>
      </aside>
    </div>
  </article>
</Base>

<script>
  import { initThreads } from '../../scripts/threads';
  import { initResume } from '../../scripts/resume';
  import { whenActive } from '../../scripts/active';
  initThreads();
  // A prerendered post must not record a position the reader never reached.
  whenActive(() => initResume(document.querySelector<HTMLElement>('.post')?.dataset.slug ?? location.pathname));
</script>

<script>
  /* Formato / Markdown: the real source, in place. Hidden without JS; the .md link still works. */
  const views = document.querySelectorAll<HTMLButtonElement>('[data-view]');
  views.forEach((b) => b.addEventListener('click', () => {
    views.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => { p.hidden = p.dataset.pane !== b.dataset.view; });
  }));

  /* Copiar: the same text the .md download gives (source plus licence line). */
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  const text = document.querySelector<HTMLElement>('.source pre')?.textContent ?? '';
  let reset = 0;
  copy?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(text); } catch { return; }
    const label = copy.querySelector('span')!;
    copy.dataset.state = 'done';
    label.textContent = 'Copiado';
    clearTimeout(reset);
    reset = window.setTimeout(() => { delete copy.dataset.state; label.textContent = 'Copiar'; }, 2000);
  });
</script>

<script>
  import { initReading } from '../../scripts/reading';
  import { whenActive } from '../../scripts/active';
  import { arriveOnRail } from '../../scripts/netmorph';
  whenActive(() => initReading(Number(document.querySelector<HTMLElement>('.post')?.dataset.minutes) || 1));
  whenActive(arriveOnRail);
</script>
