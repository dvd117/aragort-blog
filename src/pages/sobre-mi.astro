---
import Base from '../layouts/Base.astro';
import Net from '../components/Net.astro';
import { nets } from '../assets/net/geometry';
import { exitPath } from '../lib/netpath';

// The portrait lights the path from the ochre node to where the thread begins.
const path = exitPath(nets.hero);
---
<Base title="Sobre mí" current="sobre-mi" heroNet description="David Aragort: derechos digitales, seguridad digital y Ateneo Abierto." ogImage="/og/sobre-mi.png" ogAlt="Sobre mí · David Aragort">
  <!-- The copy is David's, word for word. The second sentence of the third paragraph
       is set apart visually (same words, same order); nothing is added but the three
       contact labels. -->
  <div class="about wrap">
    <header class="portrait">
      <h1 style="view-transition-name: page-title">Sobre mí</h1>
      <div class="portrait-net" style="view-transition-name: net" data-path={path.join(',')}><Net name="hero" /></div>
    </header>

    <ol class="thread" data-about-thread>
      <li class="node-item" data-hue="teal">
        <span class="node" aria-hidden="true"></span>
        <p>Hola, mi nombre es David Aragort, soy caraqueño y los últimos siete años he trabajado en derechos digitales y ayudado a personas y organizaciones a protegerse en internet, en Venezuela y en otros países de la región. Creo en aprender cosas que nadie te pueda quitar, para no depender de quien controla la herramienta.</p>
      </li>
      <li class="node-item" data-hue="sky">
        <span class="node" aria-hidden="true"></span>
        <p>Hoy quiero aportar lo que sé y lo que he vivido para reconstruir Venezuela, y Ateneo Abierto es mi forma de hacerlo.</p>
        <p class="cred"><span>Fui Freedom Fellow de la Human Rights Foundation</span> <span>y formo parte del Leadership Council de la Youth Democracy Network.</span></p>
      </li>
      <li class="node-item" data-hue="moss">
        <span class="node" aria-hidden="true"></span>
        <p>Siempre estoy buscando colaborar con gente que, como yo, trabaja por una misión y por sus valores. Si te identificas, escríbeme a <a href="mailto:hola@aragort.com">hola@aragort.com</a> y hablemos.</p>
      </li>
      <li class="node-item contact-item" data-hue="ochre">
        <span class="node" aria-hidden="true"></span>
        <dl class="contact">
          <div><dt>Correo</dt><dd><a href="mailto:hola@aragort.com">hola@aragort.com</a></dd></div>
          <div><dt>GitHub</dt><dd><a href="https://github.com/dvd117" rel="me">github.com/dvd117</a></dd></div>
          <div><dt>LinkedIn</dt><dd><a href="https://www.linkedin.com/in/davidaragort" rel="me">linkedin.com/in/davidaragort</a></dd></div>
        </dl>
      </li>
    </ol>
  </div>
</Base>

<script>
  import { initAbout } from '../scripts/about';
  initAbout();
</script>

<style>
  /* Phone first. The net is a portrait at the top (the landing's net, grown into it),
     then the story hangs on a thread: each paragraph a node that lights in its hue as
     it comes into view. Desktop: the portrait stays in a left column, the thread runs
     on the right. */
  .about { padding-top: 1.5rem; padding-bottom: 3rem; }
  .portrait { position: relative; padding-bottom: 1rem; }
  h1 { position: relative; z-index: 1; font-family: var(--display); font-weight: var(--display-weight); font-size: clamp(3.2rem, 15vw, 7rem); line-height: var(--display-leading); letter-spacing: var(--display-tracking); margin: 0; text-shadow: 0 0 2px var(--bg), 0 0 4px var(--bg), 0 0 8px var(--bg); }
  .portrait-net { margin: -1.5rem 0 0 18%; }
  .portrait-net :global(.net) { display: block; width: 100%; height: auto; }
  .portrait-net { --net-alpha: .32; }
  .portrait-net :global(.path) { stroke: var(--ochre); stroke-opacity: 1; }
  .portrait-net :global(circle.path) { fill: var(--ochre); }

  .thread { position: relative; list-style: none; margin: .5rem 0 0; padding: 0 0 0 1.75rem; }
  .thread::before { content: ""; position: absolute; left: 5px; top: 0; bottom: 2rem; width: 1px; background: var(--net); opacity: var(--net-alpha); }
  /* The lit part of the thread grows to the last lit node (set by about.ts). */
  .thread::after { content: ""; position: absolute; left: 4.5px; top: 0; width: 2px; height: var(--lit, 0px); background: var(--ochre); transition: height 240ms cubic-bezier(.2, 0, 0, 1); }
  .node-item { position: relative; padding: 0 0 2rem; }
  .node { position: absolute; left: calc(-1.75rem + 5.5px - 7px); top: .35em; width: 14px; height: 14px; border-radius: 50%; background: var(--bg); box-shadow: inset 0 0 0 2px var(--hue), 0 0 0 3px var(--bg); transition: background-color 200ms ease; }
  .node-item.is-lit .node { background: var(--hue); }
  .node-item p { font-family: var(--read-font); font-size: calc(clamp(1.125rem, 1rem + .45vw, 1.25rem) * var(--scale)); line-height: var(--leading); letter-spacing: var(--tracking); color: var(--fg-read); max-width: var(--measure); margin: 0; }
  .node-item p + p { margin-top: 1rem; }
  .node-item a { color: var(--fg); text-decoration: underline var(--underline) var(--hue); text-underline-offset: .2em; }
  /* Credentials: the same sentence, set as its own element. */
  .cred { font-family: var(--display) !important; font-weight: 600; font-size: calc(clamp(1.25rem, 1.05rem + .8vw, 1.6rem) * var(--scale)) !important; line-height: 1.25 !important; letter-spacing: -.02em !important; color: var(--fg) !important; padding-left: .9rem; border-left: 3px solid var(--hue); }
  .cred span { display: block; }
  .cred span + span { color: var(--fg-2); }

  .contact { margin: 0; display: grid; gap: .1rem; font: 400 1rem/1.3 var(--ui); }
  .contact div { display: grid; grid-template-columns: 5.5rem 1fr; align-items: center; min-height: 44px; border-bottom: 1px solid var(--rule); }
  .contact dt { color: var(--fg-2); font-size: .875rem; }
  .contact dd { margin: 0; overflow-wrap: anywhere; }
  .contact a { font-weight: 500; }

  @media (min-width: 900px) {
    .about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); column-gap: 5rem; padding-top: 4rem; padding-bottom: 5rem; align-items: start; }
    .portrait { position: sticky; top: 76px; }
    .portrait-net { margin: -2rem 0 0 8%; }
    .portrait-net { --net-alpha: .45; }
    .thread { margin-top: 1rem; padding-left: 2.25rem; }
    .node { left: calc(-2.25rem + 5.5px - 7px); }
    .node-item { padding-bottom: 2.5rem; }
  }
</style>
