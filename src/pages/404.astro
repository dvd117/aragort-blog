---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada">
  <section class="wrap missing">
    <h1>Esta página no existe.</h1>
    <p>Puede que el enlace esté mal escrito o que el texto haya cambiado de dirección. <a href="/">Ver todos los escritos</a>.</p>
  </section>
</Base>

<style>
  .missing { padding-top: 5rem; padding-bottom: 4rem; }
  h1 { font-family: var(--display); font-weight: 400; font-size: clamp(3rem, 11vw, 7rem); line-height: .9; letter-spacing: -.03em; margin: 0; max-width: 12ch; }
  p { font-family: var(--read); font-size: clamp(1.125rem, 1rem + .45vw, 1.3125rem); line-height: 1.6; max-width: 36rem; margin: 2rem 0 0; color: var(--fg-read); }
  a { color: var(--fg); text-decoration: underline 1px var(--link); text-underline-offset: .2em; box-shadow: inset 0 -.42em 0 var(--mark); }
</style>
