---
import Base from '../layouts/Base.astro';
import Net from '../components/Net.astro';
import { getPosts } from '../lib/collection';
import { formatDateEs } from '../lib/posts';
import { nets } from '../assets/net/geometry';
import { exitNode, exitPath, regionsFor } from '../lib/netpath';
import Signature from '../components/Signature.astro';
import { LEDE } from '../lib/site';
import { hasSearch } from '../lib/search';
import '../styles/track.css';
import '../styles/index.css';

const posts = await getPosts();
const searchEnabled = hasSearch(posts.length);
const exit = exitPath(nets.hero).join(',');
// Oldest first, so a new post never takes an older post's section of the net.
const oldest = [...posts].reverse();
const regions = new Map(regionsFor(nets.hero, oldest.map((p) => p.slug)).map((r, i) => [oldest[i]!.slug, r.join(',')]));
---
<Base title="David Aragort" description={LEDE} current="escritos" ogImage="/og/index.png" ogAlt={`David Aragort: ${LEDE}`}>
  <div class="index wrap" data-netnav-root data-search={searchEnabled ? '' : undefined}>
    <section class="hero">
      <div class="hero-title">
        <h1>Escritos</h1>
        <p class="lede">{LEDE}</p>
      </div>
      <div class="net-wrap" data-netnav data-exit={exit}>
        <div class="hero-net"><Net name="hero" respond flag pin={[exitNode(nets.hero)]} /></div>
      </div>
    </section>

    {posts.length === 0 ? (
      <p class="empty">Todavía no hay escritos publicados.</p>
    ) : (
      <>
        <ol class="entries" data-thread>
          {posts.map((p) => (
              <li class:list={['entry', 'feature', { draft: p.draft }]} data-hue={p.hue} data-region={regions.get(p.slug)}>
                <p class="d"><span class="node" aria-hidden="true"><span class="hue-dot" style={`view-transition-name: dot-${p.slug}`}></span></span><time datetime={p.date}>{formatDateEs(p.date)}</time></p>
                <div class="lhs">
                  <a class="t" href={`/escritos/${p.slug}/`}>{p.title}</a>
                  {p.description && <p class="ex">{p.description}</p>}
                </div>
                <div class="rhs">
                  {p.resumen && <ul class="teaser">{p.resumen.map((r) => <li>{r}</li>)}</ul>}
                  <a class="more" href={`/escritos/${p.slug}/`}>Leer · {p.minutes} min</a>
                </div>
                {p.draft && <span class="tag">borrador</span>}
              </li>
          ))}
        </ol>
        <Signature stop />
      </>
    )}
  </div>
</Base>

<script>
  import { initNetNav } from '../scripts/netnav';
  import { initFilter } from '../scripts/filter';
  initFilter();
  initNetNav();
</script>
