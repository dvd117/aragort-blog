---
import globalCss from '../styles/global.css?url';
import { headScript } from '../lib/settings';
import type { Direction } from '../data/metro';

interface Props {
  direction: Direction;
  title?: string;
}

const { direction, title = 'Metro · David Aragort' } = Astro.props;
---

<!doctype html>
<html lang="es" data-metro={direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {direction === 'anden' && (
      <>
        <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
      </>
    )}
    <link rel="stylesheet" href={globalCss} />
    <!-- Reading settings before first paint: no flash. Generated from src/lib/settings.ts. -->
    <script is:inline set:html={headScript()} />
  </head>
  <body>
    <header><slot name="header" /></header>
    <main id="contenido"><slot /></main>
    <footer><slot name="footer" /></footer>
  </body>
</html>
