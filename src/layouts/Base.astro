---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutDrawer from '../components/AboutDrawer.astro';
import { headScript } from '../lib/settings';
import { hueScript } from '../lib/lasthue';


interface Props {
  title: string;
  description?: string;
  current?: 'escritos' | 'sobre-mi';
  ogImage?: string;
  /** Alt text for the OG card; defaults to the page title. */
  ogAlt?: string;
  type?: 'website' | 'article';
  hue?: string;
  /** The index's hero net takes the shared `net` name; elsewhere the header mark does. */
  heroNet?: boolean;
  /** On a post: minutes to read, shown in the header. */
  minutes?: number;
  /** Render the reading chrome before a minute count exists (the reader route). */
  progress?: boolean;
  /** On a post: its title, for the header while reading. */
  postTitle?: string;
}
const { title, description = 'Escritos de David Aragort.', current, ogImage, ogAlt, type = 'website', hue, heroNet = false, minutes, postTitle, progress } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'David Aragort' ? title : `${title} · David Aragort`;
---
<!doctype html>
<html lang="es" data-hue={hue}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark light" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="David Aragort" href="/rss.xml" />
  <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="es_VE" />
  {ogImage && (
    <>
      <meta property="og:image" content={new URL(ogImage, Astro.site)} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={ogAlt ?? title} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    </>
  )}
  <!-- Reading settings before first paint: no flash. Generated from src/lib/settings.ts. -->
  <script is:inline set:html={headScript()} />
  <!-- A page with no hue of its own opens in the last post's. Before first paint. -->
  {!hue && <script is:inline set:html={hueScript()} />}
  <!-- JS-only controls take their final layout before first paint (no layout shift). -->
  <script is:inline>document.documentElement.classList.add('js')</script>
  <!-- Prerender same-origin pages on hover, pointerdown or focus (Chromium). Other browsers ignore it. -->
  <script type="speculationrules" is:inline set:html={JSON.stringify({ prerender: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/*.md' } }, { not: { href_matches: '/rss.xml' } }] }, eagerness: 'moderate' }] })} />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <Header current={current} netMark={!heroNet} minutes={minutes} postTitle={postTitle} progress={progress} />
  <main id="contenido">
    <slot />
  </main>
  <Footer />
  <!-- Not on "Sobre mí" itself: there the content is the page. -->
  {current !== 'sobre-mi' && <AboutDrawer />}
  <button type="button" class="to-top" data-to-top aria-label="Volver arriba" hidden><span aria-hidden="true">↑</span></button>
  <script>
    import { initToTop } from '../scripts/totop';
    import { initNetLive } from '../scripts/netlive';
    import { initDrawer } from '../scripts/drawer';
    import { whenActive } from '../scripts/active';
    initToTop();
    initDrawer();
    whenActive(initNetLive);
  </script>
</body>
</html>
