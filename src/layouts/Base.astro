---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { headScript } from '../lib/settings';


interface Props {
  title: string;
  description?: string;
  current?: 'escritos' | 'sobre-mi';
  ogImage?: string;
  type?: 'website' | 'article';
  hue?: string;
  /** The index's hero net takes the shared `net` name; elsewhere the header mark does. */
  heroNet?: boolean;
}
const { title, description = 'Escritos de David Aragort.', current, ogImage, type = 'website', hue, heroNet = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'David Aragort' ? title : `${title} · David Aragort`;
---
<!doctype html>
<html lang="es" data-hue={hue}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark light" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="David Aragort" href="/rss.xml" />
  <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="es_VE" />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
  {ogImage && <meta name="twitter:card" content="summary_large_image" />}
  <!-- Reading settings before first paint: no flash. Generated from src/lib/settings.ts. -->
  <script is:inline set:html={headScript()} />
  <!-- JS-only controls take their final layout before first paint (no layout shift). -->
  <script is:inline>document.documentElement.classList.add('js')</script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <Header current={current} netMark={!heroNet} />
  <main id="contenido">
    <slot />
  </main>
  <Footer />
</body>
</html>
