---
/*
 * Who writes this. The same block ends the landing and every post: a rule, the label
 * "Quién escribe", David's name, and under it the sentence and the way through to
 * "Sobre mí". No mark: the header and the footer already carry it.
 *
 * The name is in display type, so the sentence does not open with "Soy David Aragort,
 * caraqueño": it would be saying it twice.
 *
 * On the landing the block is the thread's last stop: a station sits on the rule, where
 * the track ends (netnav.ts). Posts have no thread, so they leave it off.
 */
import { WHO } from '../lib/site';

interface Props {
  /** The landing's copy carries the thread's terminal station on its rule. */
  stop?: boolean;
}
const { stop = false } = Astro.props;
---
<aside class="who" aria-labelledby="who-k">
  {stop && <span class="node" aria-hidden="true"><span class="hue-dot"></span></span>}
  <p class="who-k" id="who-k">Quién escribe</p>
  <p class="who-name">David Aragort</p>
  <p class="who-text">{WHO} <a href="/sobre-mi/">Sobre mí</a></p>
</aside>
