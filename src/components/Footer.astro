---
import Net from './Net.astro';
import ExtLink from './ExtLink.astro';
import { LICENCE } from '../lib/licence';

// The build year: a rebuild keeps it current, nothing to edit by hand.
const year = new Date().getFullYear();
---
<footer class="site-foot wrap">
  <Net name="mark" />
  <div class="foot-text">
    <p>{year} David Aragort · <ExtLink href={LICENCE.url} rel="license">{LICENCE.name}</ExtLink></p>
    <p><a href="/rss.xml">RSS</a></p>
  </div>
</footer>

<style>
  .site-foot { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; color: var(--fg-2); font-size: .9375rem; padding-top: 4rem; padding-bottom: 3rem; }
  .site-foot p { margin: 0; }
  /* Beside the mark; RSS wraps under the licence, never under the mark. */
  .foot-text { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.5rem; min-width: 0; flex: 1; }
  .site-foot :global(.net) { width: 38px; height: 29px; }
  .site-foot > :global(.net) { align-self: flex-start; }
  .site-foot :global(a) { color: var(--fg-2); text-underline-offset: .2em; }
  .site-foot :global(a:hover) { color: var(--fg); }
</style>
