---
import ReadingSettings from './ReadingSettings.astro';
import Net from './Net.astro';

interface Props {
  current?: 'escritos' | 'sobre-mi';
  netMark?: boolean;
  /** On a post: minutes to read. The header then carries "quedan N min" and the progress line. */
  minutes?: number;
  /** Render the reading chrome (progress line and time-left slot) without a minute count yet. */
  progress?: boolean;
  /** On a post: its title, shown in the header once the page title has scrolled away. */
  postTitle?: string;
}
const { current, netMark = true, minutes, postTitle, progress } = Astro.props;
---
<!-- Always visible, one compact row (52px on a phone). On a post the mark is the
     reading progress, with the time left beside it and a progress line along the bottom. -->
<header class="site">
  <div class="row wrap">
    <a class="brand" href="/">
      <span class:list={['mark', { 'vt-net': netMark }]}><Net name="mark" /></span>
      <span class="name"><span>David</span> <span>Aragort</span></span>
    </a>
    {(minutes || progress) && (
      <span class="doc" aria-hidden="true">
        {postTitle && <span class="doc-title">{postTitle}</span>}
        <span class="left" data-left>{minutes ? `quedan ${minutes} min` : ''}</span>
      </span>
    )}
    <nav aria-label="Principal">
      <a href="/sobre-mi/" data-drawer-open aria-current={current === 'sobre-mi' ? 'page' : undefined}>
        <!-- Drawn in the same hand as the footer's marks: a hairline ring, a head and a
             pair of shoulders. On a phone it is the whole button; from 600px the words
             come back and the glyph steps out. -->
        <svg class="nav-i" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="8" cy="8" r="6.9" /><circle class="solid" cx="8" cy="5" r="1.25" /><path d="M5.2 12.6v-2.1a2.8 2.8 0 0 1 5.6 0v2.1" />
        </svg>
        <span class="nav-t">Sobre mí</span>
      </a>
    </nav>
    <ReadingSettings />
  </div>
  {(minutes || progress) && <div class="progress" aria-hidden="true"></div>}
</header>

<style>
  .site { position: sticky; top: 0; z-index: 30; background: var(--bg); border-bottom: 1px solid var(--rule); }
  .row { position: relative; display: flex; align-items: center; gap: .9rem; min-height: 55px; padding-top: 3px; padding-bottom: 3px; }
  /* The name may shrink and break at its space, so a narrow phone gets "David" over
     "Aragort" instead of a clipped or vanished wordmark. */
  .brand { display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; font-weight: 600; font-size: 1rem; letter-spacing: -.01em; min-height: 44px; flex: 0 1 auto; min-width: 0; }
  /* Each word stays whole, so a narrow phone gets "David" over "Aragort" rather than a
     clipped or vanished wordmark. No min-width here: min-content keeps the longer word. */
  .name { display: flex; flex-wrap: wrap; column-gap: .28em; line-height: 1.12; }
  .name > span { white-space: nowrap; }
  .mark { display: block; flex: none; }
  .brand :global(.net) { width: 38px; height: 28.5px; }
  /* While reading (the post's own title out of view) the header carries it, as the
     minibar did: title over the time left.
     It takes the room between the wordmark and the nav and clips inside it: without
     `overflow`, "quedan N min" is `nowrap` and simply ran on under the nav's pill. */
  .doc { display: flex; flex-direction: column; justify-content: center; flex: 1 1 auto; min-width: 0; overflow: hidden; gap: 3px; }
  .doc-title { display: none; font: var(--title-weight) .9375rem/1.15 var(--display); letter-spacing: -.01em; color: var(--fg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .site.reading .doc-title { display: block; animation: doc-in var(--dur-draw) var(--ease) both; }
  @keyframes doc-in { from { opacity: 0; transform: translateY(6px); } }
  .left { font: 500 .8125rem/1 var(--ui); color: var(--fg-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .site.reading .left { font-size: .75rem; }
  /* The post's Formato/Markdown toggle, with one segment: a pill on a panel that raises
     while "Sobre mí" is open or is the page you are on. "Escritos" is gone from here --
     the wordmark is already the way home, and on the landing the tab only repeated the
     title under it. No transition: the tab swaps the way the toggle's buttons do, at once. */
  nav { display: inline-flex; gap: 2px; margin-left: auto; padding: 2px; border: 1px solid var(--rule); border-radius: 8px; background: var(--panel); flex: none; }
  nav a { display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 0 .7rem; border-radius: 6px; text-decoration: none; color: var(--fg-2); font-size: .9375rem; white-space: nowrap; }
  nav a:hover { color: var(--fg); }
  nav a[aria-current="page"], nav a[aria-expanded="true"] { color: var(--fg); background: var(--bg); box-shadow: 0 0 0 1px var(--rule); }
  .nav-i { display: none; width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.15; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .nav-i :global(.solid), .nav-i .solid { fill: currentColor; stroke: none; }
  .progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; pointer-events: none;
    /* The flag, laid along the text: the bar is the whole three bands and reading uncovers
       it left to right, so a post is read amarillo, then azul, then rojo. A transform
       would squash the gradient instead of revealing it, so the reveal is a clip. */
    background: linear-gradient(90deg, var(--hl-amarillo) 0 33.333%, var(--hl-azul) 33.333% 66.667%, var(--hl-rojo) 66.667% 100%);
    clip-path: inset(0 100% 0 0);
  }
  /* Phone: "Sobre mí" was a pill of words competing with the title and the time left for a
     row that has none to spare. It becomes one mark beside "Aa" -- the same size, the same
     chrome -- and keeps its words for screen readers. */
  @media (max-width: 599px) {
    nav a { width: 38px; padding: 0; }
    .nav-i { display: block; }
    .nav-t { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  /* Phone: the name stacks instead of stepping aside -- "David" over "Aragort" -- so the
     wordmark is still a name and the nav still gets its room. */
  @media (max-width: 519px) {
    .brand { gap: .45rem; }
    .name { font-size: .9375rem; }
    .name > span { flex: 0 0 100%; }
  }
  /* Reading on a phone the header carries the post's title, and the name does step aside. */
  @media (max-width: 519px) {
    .site.reading .name { position: absolute; left: 0; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    /* With the name out of the flow the brand holds only the mark, and `flex: 0 1 auto`
       plus `min-width: 0` let it shrink to 16px -- narrower than the 38px mark, which is
       `flex: none` and so kept its size and hung out of its own box. The title was then
       laid out against that 16px and started on top of the mark. The brand is the mark
       here and nothing else, so it does not shrink. */
    .site.reading .brand { flex: none; }
  }
  /* Reading on a phone: mark (home) · title and time left · Sobre mí · Aa. The nav used to
     step aside here, when it was two items competing with the title; one short pill fits,
     and it is now the only way to "Sobre mí" from a post. */
  @media (min-width: 900px) {
    .row { gap: 1.5rem; min-height: 57px; }
    .brand :global(.net) { width: 42px; height: 31.5px; }
    nav a { padding: 0 .9rem; min-height: 40px; }
  }
</style>
