---
/*
 * Ajustes de lectura. Phone: a bottom sheet, controls in thumb reach.
 * Desktop: a popover under the header button. Non-modal either way:
 * Esc or "Cerrar" closes it and focus returns to the button.
 */
const group = (legend: string, key: string, options: [string, string, string?][]) => ({ legend, key, options });
const text = [
  group('Tamaño', 'size', [['1', 'A', 'Muy pequeño'], ['2', 'A', 'Pequeño'], ['3', 'A', 'Normal'], ['4', 'A', 'Grande'], ['5', 'A', 'Muy grande']]),
  group('Interlineado', 'leading', [['1', 'Compacto'], ['2', 'Normal'], ['3', 'Amplio']]),
  group('Espacio entre letras', 'tracking', [['1', 'Normal'], ['2', 'Amplio']]),
  group('Ancho de columna', 'measure', [['1', 'Estrecho'], ['2', 'Normal'], ['3', 'Ancho']]),
];
const font = group('Tipografía', 'font', [['sans', 'Sans'], ['serif', 'Serif'], ['atkinson', 'Atkinson Hyperlegible']]);
const theme = group('Tema', 'theme', [['system', 'Sistema'], ['dark', 'Oscuro'], ['light', 'Claro'], ['sepia', 'Sepia'], ['contrast', 'Alto contraste']]);
---
<button class="ajustes-btn" type="button" aria-expanded="false" aria-controls="ajustes" data-ajustes-open>
  <span class="aa" aria-hidden="true">Aa</span> <span class="lbl">Ajustes</span>
</button>

<section id="ajustes" class="ajustes" aria-labelledby="ajustes-title" hidden>
  <div class="ajustes-head">
    <h2 id="ajustes-title" tabindex="-1">Ajustes de lectura</h2>
    <button type="button" class="ajustes-close" data-ajustes-close>Cerrar</button>
  </div>

  <div class="ajustes-body">
    <h3>Texto</h3>
    {text.map((g) => (
      <fieldset class:list={['seg', `seg-${g.key}`]}>
        <legend>{g.legend}</legend>
        <div class="opts">
          {g.options.map(([value, label, name], i) => (
            <label>
              <input type="radio" name={`aj-${g.key}`} value={value} data-key={g.key} />
              <span class={g.key === 'size' ? `sz sz-${i + 1}` : undefined} aria-hidden={name ? 'true' : undefined}>{label}</span>
              {name && <span class="visually-hidden">{name}</span>}
            </label>
          ))}
        </div>
      </fieldset>
    ))}

    <h3>Tipografía y tema</h3>
    {[font, theme].map((g) => (
      <fieldset class:list={['seg', 'seg-wrap', `seg-${g.key}`]}>
        <legend>{g.legend}</legend>
        <div class="opts">
          {g.options.map(([value, label]) => (
            <label><input type="radio" name={`aj-${g.key}`} value={value} data-key={g.key} /><span>{label}</span></label>
          ))}
        </div>
      </fieldset>
    ))}

    <h3>Enfoque y movimiento</h3>
    <div class="checks">
      <label><input type="checkbox" value="on" data-key="focus" /> <span>Resaltar el párrafo que lees</span></label>
      <label><input type="checkbox" value="all" data-key="links" /> <span>Subrayar todos los enlaces</span></label>
      <label><input type="checkbox" value="reduce" data-key="motion" /> <span>Reducir movimiento</span></label>
    </div>

    <div class="voz" data-voz hidden>
      <h3>Leer en voz alta</h3>
      <div class="voz-row">
        <button type="button" data-voz-play aria-pressed="false">Reproducir</button>
        <button type="button" data-voz-stop>Detener</button>
        <label class="voz-rate">Velocidad
          <select data-voz-rate>
            <option value="0.8">0,8×</option>
            <option value="1" selected>1×</option>
            <option value="1.2">1,2×</option>
            <option value="1.5">1,5×</option>
          </select>
        </label>
      </div>
      <p class="voz-status" data-voz-status aria-live="polite"></p>
    </div>

    <button type="button" class="ajustes-reset" data-ajustes-reset>Restablecer</button>
  </div>
</section>

<style>
  .ajustes-btn { display: inline-flex; align-items: center; gap: .45rem; font: 500 .9375rem/1 var(--ui); color: var(--fg); background: none; border: 1px solid var(--rule); border-radius: 999px; padding: .6rem .9rem; min-height: 44px; cursor: pointer; }
  .ajustes-btn:hover { border-color: var(--fg-2); }
  .ajustes-btn[aria-expanded="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  @media (max-width: 519px) { .ajustes-btn { padding: .6rem .7rem; } .lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } }
  .aa { font-family: var(--display); font-weight: var(--display-weight); letter-spacing: -.04em; font-size: 1.1rem; line-height: .8; }

  /* Phone first: a bottom sheet. */
  .ajustes {
    position: fixed; inset: auto 0 0 0; z-index: 40;
    max-height: min(82vh, 42rem); overflow-y: auto; overscroll-behavior: contain;
    background: var(--bg); color: var(--fg); border-top: 1px solid var(--rule); border-radius: 16px 16px 0 0;
    padding: .5rem 16px calc(1rem + env(safe-area-inset-bottom));
  }
  .ajustes[hidden] { display: none; }
  .ajustes::before { content: ""; display: block; width: 40px; height: 4px; border-radius: 2px; background: var(--rule); margin: .25rem auto .5rem; }
  .ajustes-head { display: flex; align-items: center; justify-content: space-between; position: sticky; top: -.5rem; background: var(--bg); padding: .5rem 0; z-index: 1; }
  h2 { font: var(--title-weight) 1.4rem/1 var(--display); letter-spacing: var(--title-tracking); margin: 0; }
  h2:focus { outline: none; }
  h2:focus-visible { outline: 2px solid var(--ochre); }
  h3 { font: 600 .8125rem/1.2 var(--ui); color: var(--fg-2); margin: 1.25rem 0 .5rem; }
  .ajustes-close, .ajustes-reset, .voz button { font: 500 .9375rem/1 var(--ui); color: var(--fg); background: var(--panel); border: 1px solid var(--rule); border-radius: 10px; padding: .7rem 1rem; min-height: 44px; cursor: pointer; }
  .ajustes-reset { width: 100%; margin-top: 1.5rem; }

  fieldset { border: 0; padding: 0; margin: 0 0 .9rem; min-width: 0; }
  legend { font: 500 .9375rem/1.3 var(--ui); padding: 0; margin-bottom: .4rem; }
  .opts { display: flex; border: 1px solid var(--rule); border-radius: 10px; overflow: hidden; }
  .seg-wrap .opts { flex-wrap: wrap; }
  .opts label { flex: 1 1 auto; position: relative; }
  .seg-wrap .opts label { flex-basis: 33%; }
  .opts input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .opts span:not(.visually-hidden) { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: .4rem .5rem; font: 500 .875rem/1.15 var(--ui); color: var(--fg-2); text-align: center; border-left: 1px solid var(--rule); }
  .opts label:first-child span { border-left: 0; }
  .opts input:checked + span { background: var(--fg); color: var(--bg); }
  .opts input:focus-visible + span { outline: 2px solid var(--ochre); outline-offset: -4px; }
  .sz { font-family: var(--display) !important; font-weight: var(--title-weight) !important; }
  .sz-1 { font-size: .95rem !important; } .sz-2 { font-size: 1.1rem !important; } .sz-3 { font-size: 1.3rem !important; }
  .sz-4 { font-size: 1.55rem !important; } .sz-5 { font-size: 1.8rem !important; }

  .checks { display: grid; gap: .25rem; }
  .checks label { display: flex; align-items: center; gap: .7rem; min-height: 44px; font: 400 1rem/1.3 var(--ui); cursor: pointer; }
  .checks input { width: 1.25rem; height: 1.25rem; accent-color: var(--fg); margin: 0; flex: none; }

  .voz-row { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .voz button[aria-pressed="true"] { background: var(--fg); color: var(--bg); }
  .voz-rate { display: inline-flex; align-items: center; gap: .5rem; font: 400 .9375rem/1 var(--ui); }
  .voz-rate select { font: inherit; color: var(--fg); background: var(--panel); border: 1px solid var(--rule); border-radius: 8px; min-height: 44px; padding: 0 .5rem; }
  .voz-status { font: 400 .875rem/1.4 var(--ui); color: var(--fg-2); margin: .5rem 0 0; min-height: 1.4em; }

  /* Desktop: a popover under the button, same controls, pointer-sized. */
  @media (min-width: 900px) {
    .ajustes { position: absolute; inset: calc(100% + .25rem) var(--gutter) auto auto; width: 25rem; max-height: calc(100vh - 7rem); border: 1px solid var(--rule); border-radius: 14px; padding: .25rem 1.25rem 1.25rem; }
    .ajustes::before { display: none; }
    .ajustes-head { top: -.25rem; }
  }
</style>

<script>
  import { DEFAULTS, LEGACY_THEME_KEY, parseSettings, serializeSettings, STORAGE_KEY, toAttributes, type Key, type Settings } from '../lib/settings';
  import { initFocus } from '../scripts/focus';
  import { initSpeech } from '../scripts/speech';

  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-ajustes-open]');
  const panel = document.getElementById('ajustes');
  const title = document.getElementById('ajustes-title');

  const load = (): Settings => {
    try { return parseSettings(localStorage.getItem(STORAGE_KEY), localStorage.getItem(LEGACY_THEME_KEY)); }
    catch { return { ...DEFAULTS }; }
  };
  let state = load();

  const save = () => {
    try {
      localStorage.setItem(STORAGE_KEY, serializeSettings(state));
      localStorage.removeItem(LEGACY_THEME_KEY);
    } catch { /* private mode: settings last this page */ }
  };

  const sync = () => {
    panel?.querySelectorAll<HTMLInputElement>('input[data-key]').forEach((i) => {
      i.checked = state[i.dataset.key as Key] === i.value;
    });
  };

  const apply = () => {
    for (const [attr, v] of Object.entries(toAttributes(state))) {
      if (v === null) root.removeAttribute(attr); else root.setAttribute(attr, v);
    }
    sync();
    document.dispatchEvent(new CustomEvent('ajustes:change'));
  };

  panel?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const key = input.dataset.key as Key | undefined;
    if (!key) return;
    const value = input.type === 'checkbox' ? (input.checked ? input.value : DEFAULTS[key]) : input.value;
    state = { ...state, [key]: value } as Settings;
    save();
    apply();
  });

  document.querySelector('[data-ajustes-reset]')?.addEventListener('click', () => {
    state = { ...DEFAULTS };
    try { localStorage.removeItem(STORAGE_KEY); localStorage.removeItem(LEGACY_THEME_KEY); } catch { /* ignore */ }
    apply();
  });

  const open = () => {
    if (!panel || !btn) return;
    panel.hidden = false;
    btn.setAttribute('aria-expanded', 'true');
    title?.focus();
  };
  const close = () => {
    if (!panel || !btn || panel.hidden) return;
    panel.hidden = true;
    btn.setAttribute('aria-expanded', 'false');
    btn.focus();
  };
  btn?.addEventListener('click', () => (panel?.hidden ? open() : close()));
  document.querySelector('[data-ajustes-close]')?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  sync();
  initFocus();

  // Read aloud: only on a post, only with the API and a local Spanish voice.
  // Imported statically: a dynamic import brings Vite's preload helper, which
  // uses root-absolute URLs and breaks the preview served from a subpath.
  const voz = document.querySelector<HTMLElement>('[data-voz]');
  if (voz && 'speechSynthesis' in window && document.querySelector('.post .prose')) initSpeech(voz);
</script>
