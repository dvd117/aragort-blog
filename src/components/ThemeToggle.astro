---
/* Claro / Oscuro. Follows the system until the reader chooses; the choice is remembered. */
---
<div class="theme" role="group" aria-label="Tema">
  <button type="button" data-set-theme="light" aria-pressed="false">Claro</button>
  <button type="button" data-set-theme="dark" aria-pressed="false">Oscuro</button>
</div>

<style>
  .theme { display: inline-flex; border: 1px solid var(--rule); border-radius: 999px; padding: 2px; }
  button { font: 500 .875rem/1 var(--ui); color: var(--fg-2); background: none; border: 0; border-radius: 999px; padding: .5rem .8rem; cursor: pointer; }
  button:hover { color: var(--fg); }
  button[aria-pressed="true"] { background: var(--fg); color: var(--bg); }
</style>

<script>
  const root = document.documentElement;
  const KEY = 'aragort-theme';
  const mq = matchMedia('(prefers-color-scheme: dark)');
  const current = () => root.dataset.theme || (mq.matches ? 'dark' : 'light');
  const sync = () => {
    const t = current();
    document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.setTheme === t));
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((b) => {
    b.addEventListener('click', () => {
      const t = b.dataset.setTheme;
      if (t !== 'light' && t !== 'dark') return;
      root.dataset.theme = t;
      try { localStorage.setItem(KEY, t); } catch { /* private mode: the choice lasts this page */ }
      sync();
    });
  });
  mq.addEventListener('change', sync);
  sync();
</script>
