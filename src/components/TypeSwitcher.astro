---
/* Preview only: switch the type family (data-family), remembered across pages.
   Never rendered in production builds. Script inline so it ships only when rendered. */
import { FAMILIES } from '../lib/families';
const entries = Object.entries(FAMILIES);
---
<div class="tipo" role="group" aria-label="Tipo (vista previa)">
  <span class="tipo-label">Tipo</span>
  {entries.map(([id, f]) => (
    <button type="button" data-tipo={id} aria-pressed="false" title={f.name}>{f.key}</button>
  ))}
  <span class="tipo-name" data-tipo-name aria-live="polite"></span>
</div>

<style>
  .tipo { position: fixed; z-index: 45; left: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 4px; padding: 4px 6px 4px 10px; background: var(--fg); color: var(--bg); border-radius: 999px; font: 600 .8125rem/1 var(--ui); box-shadow: 0 0 0 1px var(--bg); }
  .tipo-label { margin-right: 4px; }
  .tipo button { font: inherit; width: 30px; height: 30px; border-radius: 50%; border: 0; background: transparent; color: var(--bg); cursor: pointer; }
  .tipo button[aria-pressed="true"] { background: var(--bg); color: var(--fg); }
  .tipo button:focus-visible { outline: 2px solid var(--ochre); outline-offset: 1px; }
  .tipo-name { font-weight: 500; margin: 0 6px 0 4px; white-space: nowrap; }
</style>

<script is:inline>
(function () {
  var root = document.documentElement;
  var names = { bricolage: 'Bricolage', schibsted: 'Schibsted', geist: 'Geist', space: 'Space' };
  var btns = document.querySelectorAll('[data-tipo]');
  var label = document.querySelector('[data-tipo-name]');
  function sync() {
    var cur = root.getAttribute('data-family');
    btns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-tipo') === cur)); });
    if (label) label.textContent = names[cur] || '';
  }
  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      var f = b.getAttribute('data-tipo');
      root.setAttribute('data-family', f);
      try { localStorage.setItem('aragort-tipo', f); } catch (e) {}
      sync();
    });
  });
  sync();
})();
</script>
