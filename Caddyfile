{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Raw post sources: /escritos/<slug>.md
	@markdown path *.md
	header @markdown Content-Type "text/markdown; charset=utf-8"

	# Hashed assets and fonts never change under the same name.
	@immutable path /_astro/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin
		# TLS is terminated by Traefik in front; this header rides through it.
		# includeSubDomains and preload are deliberately left off until every
		# subdomain of aragort.com is known to be HTTPS-only. NOTE: the Deflect
		# edge appends its own HSTS with both directives set. Ours wins only
		# because a UA reads the first one (RFC 6797 8.1) -- fix at the edge
		# toggle, not here. See README, "Security headers".
		Strict-Transport-Security "max-age=31536000"
		# Nothing here uses a permission-gated API. Read aloud is speech synthesis,
		# which is not gated.
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"
		# Written at build time by scripts/csp.mjs: script-src carries a hash per
		# inline script instead of 'unsafe-inline'.
		import /etc/caddy/csp.caddy
		-Server
	}

	file_server

	# Anything missing goes back to the landing rather than a dead end.
	handle_errors {
		header -Server
		redir * / 302
	}
}
