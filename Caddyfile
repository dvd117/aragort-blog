{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Raw post sources: /escritos/<slug>.md
	@markdown path *.md
	header @markdown Content-Type "text/markdown; charset=utf-8"

	# Hashed assets and fonts never change under the same name.
	@immutable path /_astro/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		-Server
	}

	file_server

	# Anything missing goes back to the landing rather than a dead end.
	handle_errors {
		header -Server
		redir * / 302
	}
}
